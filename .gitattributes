# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf
*.bash text eol=lf

# PowerShell scripts can use CRLF (Windows default)
*.ps1 text eol=crlf

# Batch files should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# C# source files use LF, matching .editorconfig ([*] end_of_line = lf) and the working tree
*.cs text eol=lf

# JSON files should use LF
*.json text eol=lf

# YAML files should use LF
*.yml text eol=lf
*.yaml text eol=lf

# Markdown files should use LF
*.md text eol=lf

# XML files and MSBuild project files should use LF
*.xml text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf

# Web assets served from docs/ should use LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf

# Config files should use LF
*.config text eol=lf
*.editorconfig text eol=lf

# Binary files
*.lic binary
*.dll binary
*.exe binary
*.pdb binary
*.zip binary

# Generated and vendored files. Neither is written by hand, so neither should be counted as
# this project's own source in language statistics or shown expanded in a diff by default
# (R3-DOC09). Both are still published verbatim by the Pages workflow; these attributes
# affect how the files are presented, not whether they are shipped.
docs/architecture-map/index.html linguist-generated=true
docs/architecture-map/metadata.json linguist-generated=true
docs/assets/vis-network.min.js linguist-vendored=true
